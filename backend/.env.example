# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# Neon → your project → Connect → "Connection pooling" ON → copy the connection string.
# Leave unset to use a local SQLite file (backend/nutrilens.db) for offline development.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: enables the AI fallback for hard-to-read reports.
GEMINI_API_KEY=

# Optional: lets the assistant answer any question in natural language (English, Hindi, Telugu), grounded in
# Biomvira's own knowledge. Free key, no card: https://console.groq.com/keys . Without it the assistant uses its
# rule-based answers only. Another OpenAI-compatible provider: set CHAT_LLM_API_KEY, CHAT_LLM_BASE_URL, CHAT_LLM_MODELS.
GROQ_API_KEY=

# Production only (Render): cookies must be HTTPS-only.
# COOKIE_SECURE=true
